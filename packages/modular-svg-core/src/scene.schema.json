{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"title": "SceneNode",
	"type": "object",
	"properties": {
		"type": {
			"type": "string",
			"enum": [
				"Group",
				"Rect",
				"Circle",
				"Background",
				"StackV",
				"StackH",
				"Align",
				"Distribute",
				"Ref",
				"Text",
				"Arrow",
				"Line",
				"Curve",
				"Image",
				"Path",
				"Arc",
				"Span",
				"DistinctColors",
				"SameColor",
				"Lighten",
				"Darken",
				"Contrast",
				"Motion",
				"Enter",
				"Exit",
				"Draw",
				"Shake",
				"Wiggle",
				"Sampled",
				"Travel",
				"Sequence",
				"SameTime",
				"Stagger",
				"Before",
				"After",
				"During",
				"Stretch",
				"At",
				"Beat",
				"OnBeat",
				"Legato",
				"Staccato",
				"Bar",
				"Rest",
				"Fermata",
				"Polyrhythm"
			]
		},
		"id": { "type": "string" },
		"props": {
			"type": "object",
			"properties": {
				"width": { "type": "number" },
				"height": { "type": "number" },
				"x": { "type": "number" },
				"y": { "type": "number" },
				"r": { "type": "number" },
				"cx": { "type": "number" },
				"cy": { "type": "number" },
				"spacing": { "type": "number" },
				"total": { "type": "number" },
				"alignment": { "type": "string" },
				"axis": { "type": "string" },
				"direction": { "type": "string" },
				"fill": { "type": "string" },
				"stroke": { "type": "string" },
				"stroke-width": { "type": "number" },
				"text": { "type": "string" },
				"padding": { "type": "number" },
				"zOrder": { "type": "number" },
				"href": { "type": "string" },
				"d": { "type": "string" },
				"innerR": { "type": "number" },
				"startAngle": { "type": "number" },
				"endAngle": { "type": "number" },
				"font-size": { "type": "number" },
				"source": {
					"type": "array",
					"items": { "type": "number" },
					"minItems": 2,
					"maxItems": 2
				},
				"target": {
					"type": "array",
					"items": { "type": "number" },
					"minItems": 2,
					"maxItems": 2
				},
				"padStart": { "type": "number" },
				"padEnd": { "type": "number" },
				"saturation": { "type": "number" },
				"lightness": { "type": "number" },
				"startHue": { "type": "number" },
				"ratio": { "type": "number" },
				"amount": { "type": "number" }
			},
			"additionalProperties": true
		},
		"children": { "type": "array", "items": { "$ref": "#" } },
		"target": { "type": "string" },
		"paint": { "type": "string", "enum": ["fill", "stroke"] }
	},
	"required": ["type"],
	"additionalProperties": false
}
