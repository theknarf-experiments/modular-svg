{
	"compilerOptions": {
		"incremental": true,
		"target": "es2022",
		"lib": ["es2022"],
		"module": "esnext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"resolveJsonModule": true,
		"types": ["node"],
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"noImplicitAny": true,
		"strictNullChecks": true,
		"noImplicitThis": true,
		"skipLibCheck": true
	},
	// The repo root's own TypeScript; packages set their own include
	"include": ["bin", "examples", "vitest.config.ts"]
}
